{
  "name": "VaR Analysis Tool",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "app.py"]
    },
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  },
  "updateContentCommand": "pip3 install --user -r requirements-dev.txt",
  "postAttachCommand": {
    "server": "streamlit run app.py --server.port 8501 --server.enableCORS false --server.enableXsrfProtection false"
  },
  "portsAttributes": {
    "8501": {
      "label": "VaR Analysis Tool",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [8501]
}
